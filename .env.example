# CramAQuest Environment Variables Example
# Duplicate this file as '.env' in the root directory and add your real API keys.
# DO NOT commit your actual '.env' file containing your keys to Git!

# Google Gemini API Key(s) from Google AI Studio (https://aistudio.google.com/)
# You can provide a single key or a comma-separated list (e.g. key1,key2,key3) for automatic rotation when quota is exceeded.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Groq API Key (Optional fallback) - Get one at https://console.groq.com/
# Real API keys typically start with 'gsk_'
VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# OpenRouter API Key (Optional fallback) - Get one at https://openrouter.ai/
# Real API keys typically start with 'sk-or-'
VITE_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Google Gemini API Fallback Key
VITE_GEMINI_FALLBACK_API_KEY=YOUR_GEMINI_FALLBACK_API_KEY_HERE

# Pico Apps HTTP API Endpoint with Key
VITE_PICO_HTTP_API_URL=YOUR_PICO_HTTP_API_URL_HERE

